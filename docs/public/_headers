# Cloudflare Pages Custom HTTP Headers
# Long-term caching for immutable VitePress assets with hash in filename
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# LLM Discoverability Endpoints (llmstxt.org standard)
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Security and caching headers for HTML & documents
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

